# Copia este archivo a ".env" y completa con las credenciales de tu proyecto Supabase
# cuando quieras habilitar el guardado en la nube y las suscripciones de Stripe.
# Mientras no existan estas variables, la app funciona 100% con localStorage.
#
# La secret key de Stripe y la service_role key de Supabase NUNCA van acá —
# solo se usan server-side, en supabase/functions/.env (ver SETUP.md).

REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
